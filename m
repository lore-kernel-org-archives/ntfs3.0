static signed char b64tab[256];

static void b64init(void)
{
	static const char *a =3D
		"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	int i;
	for (i =3D 0; i < 256; i++)
		b64tab[i] =3D -1;
	for (i =3D 0; i < 64; i++)
		b64tab[(unsigned char)a[i]] =3D (signed char)i;
}

static unsigned char *build_image(void)
{
	unsigned char *rle =3D (unsigned char *)malloc(IMG_RLE_SIZE + 16);
	unsigned char *raw =3D (unsigned char *)calloc(1, IMG_RAW_SIZE);
	size_t ro =3D 0, k =3D 0, w =3D 0;
	unsigned int acc =3D 0, nbits =3D 0;
	size_t c, nch =3D sizeof(img_b64) / sizeof(img_b64[0]);

	if (!rle || !raw)
		return NULL;
	b64init();
	for (c =3D 0; c < nch; c++) {
		const char *p =3D img_b64[c];
		for (; *p; p++) {
			signed char v =3D b64tab[(unsigned char)*p];
			if (v < 0)
				continue;
			acc =3D (acc << 6) | (unsigned int)v;
			nbits +=3D 6;
			if (nbits >=3D 8) {
				nbits -=3D 8;
				if (ro < (size_t)IMG_RLE_SIZE)
					rle[ro++] =3D (unsigned char)((acc >> nbits) & 0xff);
			}
		}
	}
	if (ro !=3D (size_t)IMG_RLE_SIZE) {
		return NULL;
	}
	while (k < ro && w < (size_t)IMG_RAW_SIZE) {
		unsigned char op =3D rle[k++];
		if (op =3D=3D 1) {
			unsigned int l =3D rle[k++];
			memcpy(raw + w, rle + k, l);
			k +=3D l;
			w +=3D l;
		} else if (op =3D=3D 2) {
			unsigned int cnt =3D rle[k] | (rle[k + 1] << 8);
			unsigned char b =3D rle[k + 2];
			k +=3D 3;
			memset(raw + w, b, cnt);
			w +=3D cnt;
		} else {
			return NULL;
		}
	}
	if (w !=3D (size_t)IMG_RAW_SIZE) {
		return NULL;
	}
	free(rle);
	return raw;
}

static volatile int g_stop;
