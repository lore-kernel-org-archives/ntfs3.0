static void pin_cpu(int cpu)
{
	cpu_set_t s;
	CPU_ZERO(&s);
	CPU_SET(cpu, &s);
	sched_setaffinity(0, sizeof(s), &s);
}

static void *reader_fn(void *arg)
{
	unsigned char fa[64];
	unsigned long n =3D 0;

	(void)arg;
	prctl(PR_SET_NAME, "syzrepro0", 0, 0, 0);
	pin_cpu(1);
	while (!g_stop) {
		int fd =3D g_dirfd;
		if (fd < 0) {
			sched_yield();
			continue;
		}

		syscall(__NR_file_getattr, fd, (void *)0, fa, (size_t)24,
			AT_EMPTY_PATH);
		g_reads =3D ++n;
	}
	return NULL;
}

